// $Id: c0b2ff54c1959400b458c410b7f7ed819b25912d $


// The names here are abbreviations that I am introducing, typically
// very short and I hope therefore easy to remember and type.


// Here are som marks I might expect to like using in mathematics.
     {0x2102,          "!C"},   // double struck C for complex numbers
     {0x2115,          "!N"},   // double struck N for natural numbers
     {0x211a,          "!Q"},   // double struck Q for rational numbers
     {0x211d,          "!R"},   // double struck R for real numbers
     {0x2124,          "!Z"},   // double struck | for integers
     {0x2264,          "<="},
     {0x2265,          ">="},
     {0x2260,          "!="},
     {0x2280,          "_0"},   // subscript digits
     {0x2281,          "_1"},
     {0x2282,          "_2"},
     {0x2283,          "_3"},
     {0x2284,          "_4"},
     {0x2285,          "_5"},
     {0x2286,          "_6"},
     {0x2287,          "_7"},
     {0x2288,          "_8"},
     {0x2289,          "_9"},
     {0x2070,          "^0"},   // superscript digits
     {0x00b9,          "^1"},
     {0x00b2,          "^2"},
     {0x00b3,          "^3"},
     {0x2074,          "^4"},
     {0x2075,          "^5"},
     {0x2076,          "^6"},
     {0x2077,          "^7"},
     {0x2078,          "^8"},
     {0x2079,          "^9"},

// Now Latim Extended A provides dedicated single codes for what
// might otherwise be rendered using the basic letter followed by
// a combining mark. Here I set up patterns where I use a single
// character after the "#" to indicate the particular diacritical
// involved and a pattern string long enough to introduce the proper
// single basic code for the combination.

// If I also have a mapping do that e.g. "#," turns into a combining
// cedilla than with these table entries "c#," turns into the dedicated
// character while "+#," would used the combinng cedilla to attach it to
// the plus sign.

// macron marks a long vowel and is a long line above the letter.
// I will use "#_" to underline a character so I use "#~" for macron.
// I will have "#-" for a short line across the middle oi a letter.

    {0x100,     "A#~"},   // A-macron
    {0x101,     "a#~"},   // a-macron
    {0x102,     "A#u"},   // A-breve
    {0x103,     "a#u"},   // a-breve
    {0x105,     "a#;"},   // a-ogonek
    {0x106,     "C#'"},   // C-acutw
    {0x107,     "c#'"},   // c-acute
    {0x108,     "C#^"},   // C-circumflex
    {0x109,     "c#^"},   // c-circumflex
    {0x10a,     "C#."},   // C-dot-above
    {0x10b,     "c#."},   // c-dot-above
    {0x10c,     "C#v"},   // C-caron
    {0x10d,     "c#v"},   // c-caron
    {0x10e,     "D#v"},   // D-caron
    {0x10f,     "d#v"},   // d-caron

// From here down things need to be sorted out! What I have is a
// placeholder. But I believe that at least almost all of Latin Extended A
// will deserve abbreviations here.

    {0x110,     "???"},
    {0x111,     "A?~"},   // A-macron
    {0x112,     "a?~"},   // a-macron
