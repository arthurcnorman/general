// $Id: c0b2ff54c1959400b458c410b7f7ed819b25912d $

// This supports a test as to whether a codepoint denotes a combining
// mark of some sort,There are a couple of thousand such among the
// million or so potential unicode characters.

// This file has been created by looking at the UnicodeData file that
// gives official information on all codepoints and keeping just the
// items that have general class M*.

// These are given the names Unicode uses), but rendered in lower rather than
// upper case and with underscores in place of embedded spaces,These names
// are mostly rather long! So using them will be ugly.

// In this table I set the top bit of the notional codepoint to flag
// the character as "special".

#define C(n) ((n) | 0x80000000)

    {C(0x0300),  "#combining_grave_accent"},
